{% extends 'base.html.twig' %}

{% block title %}Configurer le compte 17b.fr{% endblock %}

{% block body %}
    {% set accountParams = isAdminContext is defined and isAdminContext and currentAccountId is defined and currentAccountId ? { accountId: currentAccountId } : {} %}
    <main id="contenu-principal" class="mx-auto flex min-h-screen w-full max-w-5xl flex-col gap-6 px-4 py-12 sm:px-6 lg:px-8">
        <section class="ui-card space-y-4">
            {% for message in app.flashes('success') %}
                {% include 'components/ui/alert.html.twig' with {
                    tone: 'success',
                    title: 'Succès',
                    message: message
                } %}
            {% endfor %}

            {% for message in app.flashes('error') %}
                {% include 'components/ui/alert.html.twig' with {
                    tone: 'danger',
                    title: 'Erreur',
                    message: message
                } %}
            {% endfor %}

            {% if passwordError %}
                {% include 'components/ui/alert.html.twig' with {
                    tone: 'warning',
                    title: 'Mot de passe illisible',
                    message: 'Le mot de passe stocké ne peut pas être déchiffré. Définissez-en un nouveau ci-dessous.'
                } %}
            {% endif %}

            <div>
                <p class="text-xs uppercase tracking-wide text-slate-400">Nouveau domaine</p>
                <h1 class="text-2xl font-semibold">Ajouter votre compte @17b.fr</h1>
                <p class="mt-2 text-sm text-slate-300">Votre adresse @b17.fr reste active. Ajoutez le nouveau compte en parallèle dans votre logiciel de messagerie.</p>
            </div>
        </section>

        {% if mailboxMigration is null %}
            {% include 'components/ui/alert.html.twig' with {
                tone: 'info',
                title: 'Compte pas encore créé',
                message: 'Le compte 17b.fr n’est pas encore provisionné pour cette adresse. Contactez un administrateur.'
            } %}
        {% elseif mailboxMigration.status == 'skipped' %}
            {% include 'components/ui/alert.html.twig' with {
                tone: 'warning',
                title: 'Compte déjà présent chez OVH',
                message: mailboxMigration.lastError ?: 'Le mot de passe n’a pas été enregistré. Un administrateur doit relancer la création avec --force, ou définissez un mot de passe ci-dessous si le compte existe.'
            } %}
        {% elseif mailboxMigration.status == 'error' %}
            {% include 'components/ui/alert.html.twig' with {
                tone: 'danger',
                title: 'Création incomplète',
                message: mailboxMigration.lastError ?: 'La création du compte a échoué.'
            } %}
        {% endif %}

        {% if mailboxMigration %}
            <section class="ui-card space-y-4">
                <h2 class="text-xl font-semibold">Identifiants</h2>
                <dl class="grid gap-4 sm:grid-cols-2">
                    <div>
                        <dt class="text-xs uppercase tracking-wide text-slate-400">Ancienne adresse</dt>
                        <dd class="mt-1 font-medium">{{ mailboxMigration.sourceEmail }}</dd>
                    </div>
                    <div>
                        <dt class="text-xs uppercase tracking-wide text-slate-400">Nouvelle adresse</dt>
                        <dd class="mt-1 font-medium">{{ mailboxMigration.targetEmail }}</dd>
                    </div>
                    <div class="sm:col-span-2">
                        <dt class="text-xs uppercase tracking-wide text-slate-400">Mot de passe</dt>
                        <dd class="mt-1 flex flex-wrap items-center gap-2">
                            {% if mailPassword %}
                                <input
                                    id="mail-password"
                                    type="password"
                                    readonly
                                    value="{{ mailPassword }}"
                                    class="min-w-[16rem] flex-1 rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 font-mono text-slate-100"
                                >
                                <button type="button" class="ui-button-secondary" data-toggle-password="mail-password">Afficher</button>
                                <button type="button" class="ui-button-primary" data-copy="#mail-password">Copier</button>
                            {% else %}
                                <span class="text-sm text-slate-300">Aucun mot de passe enregistré. Définissez-en un ci-dessous.</span>
                            {% endif %}
                        </dd>
                    </div>
                </dl>
            </section>

            <section class="ui-card space-y-4">
                <h2 class="text-xl font-semibold">Paramètres serveur</h2>
                <p class="text-sm text-slate-300">Nom d’utilisateur: l’adresse complète <strong>{{ mailboxMigration.targetEmail }}</strong></p>
                <dl class="grid gap-4 sm:grid-cols-2">
                    <div class="rounded-lg border border-slate-800 bg-slate-950/40 p-4">
                        <dt class="text-xs uppercase tracking-wide text-slate-400">Réception IMAP</dt>
                        <dd class="mt-2 space-y-1 text-sm">
                            <p>Serveur: <span class="font-mono">{{ mailClientSettings.imapHost }}</span></p>
                            <p>Port: <span class="font-mono">{{ mailClientSettings.imapPort }}</span></p>
                            <p>Sécurité: {{ mailClientSettings.imapEncryption }}</p>
                        </dd>
                    </div>
                    <div class="rounded-lg border border-slate-800 bg-slate-950/40 p-4">
                        <dt class="text-xs uppercase tracking-wide text-slate-400">Envoi SMTP</dt>
                        <dd class="mt-2 space-y-1 text-sm">
                            <p>Serveur: <span class="font-mono">{{ mailClientSettings.smtpHost }}</span></p>
                            <p>Port: <span class="font-mono">{{ mailClientSettings.smtpPort }}</span></p>
                            <p>Sécurité: {{ mailClientSettings.smtpEncryption }}</p>
                        </dd>
                    </div>
                </dl>
            </section>

            <section class="ui-card space-y-4">
                <h2 class="text-xl font-semibold">Ajouter le compte automatiquement</h2>
                <p class="text-sm text-slate-300">Sur iPhone, iPad ou Mac, téléchargez le profil: il préremplit serveur, identifiant et mot de passe.</p>
                {% if mailboxMigration.readyForClientSetup and mailPassword %}
                    <a class="ui-button-primary inline-flex" href="{{ path('app_user_mailbox_setup_apple', accountParams) }}">Télécharger le profil Apple Mail</a>
                {% else %}
                    <p class="text-sm text-slate-400">Le profil Apple sera disponible dès qu’un mot de passe est enregistré.</p>
                {% endif %}
            </section>

            <section class="ui-card space-y-4">
                <h2 class="text-xl font-semibold">Outlook, Thunderbird et les autres</h2>
                <ol class="list-decimal space-y-2 pl-5 text-sm text-slate-300">
                    <li>Ajoutez un compte IMAP (pas Exchange, pas POP).</li>
                    <li>Adresse e-mail: <span class="font-mono text-slate-100">{{ mailboxMigration.targetEmail }}</span></li>
                    <li>Mot de passe: celui affiché ci-dessus (ou celui que vous définissez).</li>
                    <li>Serveur de réception: <span class="font-mono text-slate-100">{{ mailClientSettings.imapHost }}</span> / {{ mailClientSettings.imapPort }} / SSL</li>
                    <li>Serveur d’envoi: <span class="font-mono text-slate-100">{{ mailClientSettings.smtpHost }}</span> / {{ mailClientSettings.smtpPort }} / SSL</li>
                    <li>Authentification SMTP activée, avec la même adresse et le même mot de passe.</li>
                </ol>
            </section>

            <section class="ui-card space-y-4">
                <h2 class="text-xl font-semibold">Choisir un mot de passe</h2>
                <p class="text-sm text-slate-300">Entre 9 et 30 caractères, avec majuscule, minuscule, chiffre et caractère spécial. OVH refuse les accents.</p>
                <form method="post" action="{{ path('app_user_mailbox_setup_password') }}" class="space-y-3">
                    <input type="hidden" name="_token" value="{{ csrf_token('mailbox_setup_password') }}">
                    {% if currentAccountId %}
                        <input type="hidden" name="accountId" value="{{ currentAccountId }}">
                    {% endif %}
                    <div class="grid gap-3 sm:grid-cols-2">
                        <label class="block text-sm">
                            <span class="mb-1 block text-slate-200">Nouveau mot de passe</span>
                            <input type="password" name="password" required minlength="9" maxlength="30" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-slate-100">
                        </label>
                        <label class="block text-sm">
                            <span class="mb-1 block text-slate-200">Confirmation</span>
                            <input type="password" name="passwordConfirmation" required minlength="9" maxlength="30" class="w-full rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-slate-100">
                        </label>
                    </div>
                    <button type="submit" class="ui-button-primary">Enregistrer le mot de passe</button>
                </form>
            </section>
        {% endif %}
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('[data-toggle-password]').forEach((button) => {
                button.addEventListener('click', () => {
                    const input = document.getElementById(button.getAttribute('data-toggle-password'));
                    if (!input) {
                        return;
                    }
                    const hidden = input.type === 'password';
                    input.type = hidden ? 'text' : 'password';
                    button.textContent = hidden ? 'Masquer' : 'Afficher';
                });
            });

            document.querySelectorAll('[data-copy]').forEach((button) => {
                button.addEventListener('click', async () => {
                    const input = document.querySelector(button.getAttribute('data-copy'));
                    if (!input) {
                        return;
                    }
                    try {
                        await navigator.clipboard.writeText(input.value);
                        button.textContent = 'Copié';
                        setTimeout(() => {
                            button.textContent = 'Copier';
                        }, 1500);
                    } catch {
                        input.select();
                        document.execCommand('copy');
                    }
                });
            });
        });
    </script>
{% endblock %}
