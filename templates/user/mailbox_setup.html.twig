{% extends 'base.html.twig' %}

{% block title %}Configurer le compte 17b.fr{% endblock %}

{% block body %}
    {% set accountParams = currentAccountId is defined and currentAccountId ? { accountId: currentAccountId } : mailbox_route_params() %}
    {% set wizardParams = client ? accountParams|merge({ client: client }) : accountParams %}
    <main id="contenu-principal" class="relative mx-auto flex min-h-screen w-full max-w-5xl flex-col gap-6 px-4 py-12 sm:px-6 lg:px-8">
        {% if canSetup %}
            <a
                class="fixed right-6 top-6 z-50 inline-flex h-11 w-11 items-center justify-center rounded-full border border-slate-800 bg-slate-950/40 text-slate-200 hover:bg-slate-900 hover:text-slate-100"
                href="{{ path('app_user_account', accountParams) }}"
                aria-label="Fermer"
                title="Fermer"
            >
                <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <path d="M6 6L18 18"></path>
                    <path d="M18 6L6 18"></path>
                </svg>
            </a>
        {% endif %}

        {% for message in app.flashes('success') %}
            {% include 'components/ui/alert.html.twig' with { tone: 'success', title: 'Succès', message: message } %}
        {% endfor %}
        {% for message in app.flashes('error') %}
            {% include 'components/ui/alert.html.twig' with { tone: 'danger', title: 'Erreur', message: message } %}
        {% endfor %}
        {% if passwordError %}
            {% include 'components/ui/alert.html.twig' with {
                tone: 'warning',
                title: 'Mot de passe illisible',
                message: 'Le mot de passe stocké ne peut pas être déchiffré. Contacte un administrateur.'
            } %}
        {% endif %}

        {% if not canSetup %}
            <section class="ui-card space-y-4">
                <h1 class="text-2xl font-semibold">Ajouter votre compte @17b.fr</h1>
                {% include 'components/ui/alert.html.twig' with {
                    tone: 'info',
                    title: 'Compte pas encore créé',
                    message: 'Le compte 17b.fr n’est pas encore provisionné pour cette adresse. Contacte un administrateur.'
                } %}
            </section>
        {% else %}
            <div class="mx-auto w-full max-w-lg">
                <p class="text-center text-xs uppercase tracking-wide text-slate-400">Étape {{ stepNumber }} / {{ stepCount }}</p>
                <div class="mt-2 h-1 overflow-hidden rounded-full bg-slate-800">
                    <div class="h-full bg-indigo-400" style="width: {{ (stepNumber / stepCount * 100)|round }}%"></div>
                </div>
            </div>

            {% if previousStep %}
                <div class="mx-auto flex w-full max-w-lg justify-start">
                    <a class="ui-button-secondary" href="{{ path('app_user_mailbox_setup', wizardParams|merge({ step: previousStep })) }}">Retour</a>
                </div>
            {% endif %}

            {% if step == 'intro' %}
                <div class="mx-auto max-w-lg text-center">
                    <h1 class="text-balance text-4xl font-semibold leading-tight sm:text-5xl">On ajoute ta nouvelle adresse</h1>
                    <p class="mt-4 text-base text-slate-300">{{ sourceEmail }} reste active. On va ajouter <strong>{{ targetEmail }}</strong> à côté, dans le même logiciel de messagerie.</p>
                    <p class="mt-2 text-sm text-slate-400">Ne supprime pas l’ancien compte. Les deux coexistent.</p>
                </div>
                <div class="mx-auto mt-8 flex max-w-lg justify-end">
                    <a class="ui-button-primary px-6 py-3 text-base" href="{{ path('app_user_mailbox_setup', wizardParams|merge({ step: nextStep })) }}">C’est parti</a>
                </div>

            {% elseif step == 'client' %}
                <div class="mx-auto max-w-lg text-center">
                    <h1 class="text-balance text-4xl font-semibold leading-tight sm:text-5xl">Quel logiciel utilises-tu&nbsp;?</h1>
                    <p class="mt-3 text-sm text-slate-400">Les étapes suivantes s’adaptent à ton choix.</p>
                </div>
                <div class="mx-auto mt-8 grid max-w-lg gap-3">
                    {% for clientKey, clientName in clients %}
                        <a
                            class="flex items-center justify-between rounded-xl border {{ client == clientKey ? 'border-indigo-400 bg-indigo-500/10' : 'border-slate-800 bg-slate-950/40' }} px-4 py-4 text-base font-medium text-slate-100 hover:border-indigo-400"
                            href="{{ path('app_user_mailbox_setup', accountParams|merge({ step: 'identifiants', client: clientKey })) }}"
                        >
                            <span>{{ clientName }}</span>
                            <span class="text-slate-400">→</span>
                        </a>
                    {% endfor %}
                </div>

            {% elseif step == 'identifiants' %}
                <div class="mx-auto max-w-lg text-center">
                    <h1 class="text-balance text-4xl font-semibold leading-tight sm:text-5xl">Voici tes identifiants</h1>
                    <p class="mt-3 text-sm text-slate-400">Tu en auras besoin pour ajouter le compte. Copie l’adresse et le mot de passe transmis par l’administrateur.</p>
                </div>
                <section class="ui-card mx-auto mt-8 max-w-lg space-y-4">
                    <div>
                        <p class="text-xs uppercase tracking-wide text-slate-400">Adresse à ajouter</p>
                        <div class="mt-1 flex flex-wrap items-center gap-2">
                            <input id="mail-email" type="text" readonly value="{{ targetEmail }}" class="min-w-[16rem] flex-1 rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 font-mono text-slate-100">
                            <button type="button" class="ui-button-primary" data-copy="#mail-email">Copier</button>
                        </div>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-wide text-slate-400">Mot de passe</p>
                        <div class="mt-1 flex flex-wrap items-center gap-2">
                            {% if mailPassword %}
                                <input id="mail-password" type="password" readonly value="{{ mailPassword }}" class="min-w-[16rem] flex-1 rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 font-mono text-slate-100">
                                <button type="button" class="ui-button-secondary" data-toggle-password="mail-password">Afficher</button>
                                <button type="button" class="ui-button-primary" data-copy="#mail-password">Copier</button>
                            {% else %}
                                <p class="text-sm text-slate-300">Aucun mot de passe enregistré. Contacte un administrateur.</p>
                            {% endif %}
                        </div>
                    </div>
                </section>
                <div class="mx-auto mt-8 flex max-w-lg justify-end">
                    {% if mailPassword and nextStep %}
                        <a class="ui-button-primary px-6 py-3 text-base" href="{{ path('app_user_mailbox_setup', wizardParams|merge({ step: nextStep })) }}">Continuer</a>
                    {% else %}
                        <p class="text-sm text-slate-400">Sans mot de passe, l’installation ne peut pas continuer. Demande-le à un administrateur.</p>
                    {% endif %}
                </div>

            {% elseif step == 'profil' %}
                <div class="mx-auto max-w-lg text-center">
                    <h1 class="text-balance text-4xl font-semibold leading-tight sm:text-5xl">Installation automatique</h1>
                    {% if client == 'iphone' %}
                        <p class="mt-3 text-sm text-slate-300">Sur iPhone ou iPad, ouvre ce profil : il préremplit serveur, identifiant et mot de passe. L’ancien compte @b17.fr reste en place.</p>
                    {% else %}
                        <p class="mt-3 text-sm text-slate-300">Sur Mac, télécharge le profil puis double-clique dessus. Mail ajoute {{ targetEmail }} sans toucher à {{ sourceEmail }}.</p>
                    {% endif %}
                </div>
                <section class="ui-card mx-auto mt-8 max-w-lg space-y-4">
                    <ol class="list-decimal space-y-2 pl-5 text-sm text-slate-300">
                        {% if client == 'iphone' %}
                            <li>Télécharge le profil ci-dessous (de préférence depuis Safari).</li>
                            <li>Ouvre Réglages : un bandeau « Profil téléchargé » apparaît.</li>
                            <li>Installe le profil, puis saisis le code de l’iPhone si demandé.</li>
                            <li>Ouvre Mail : tu dois voir {{ targetEmail }} en plus de {{ sourceEmail }}.</li>
                        {% else %}
                            <li>Télécharge le profil ci-dessous.</li>
                            <li>Double-clique le fichier <span class="font-mono">.mobileconfig</span>.</li>
                            <li>Va dans Réglages Système → Confidentialité et sécurité → Profils, puis installe-le.</li>
                            <li>Ouvre Mail : {{ targetEmail }} apparaît à côté de l’ancien compte.</li>
                        {% endif %}
                    </ol>
                    {% if mailPassword %}
                        <a class="ui-button-primary inline-flex" href="{{ path('app_user_mailbox_setup_apple', wizardParams) }}">Télécharger le profil Apple Mail</a>
                    {% else %}
                        <p class="text-sm text-slate-400">Le profil sera disponible dès qu’un mot de passe est enregistré.</p>
                    {% endif %}
                </section>
                <div class="mx-auto mt-8 flex max-w-lg justify-end">
                    <a class="ui-button-primary px-6 py-3 text-base" href="{{ path('app_user_mailbox_setup', wizardParams|merge({ step: nextStep })) }}">Continuer</a>
                </div>

            {% elseif step == 'ajout' %}
                <div class="mx-auto max-w-2xl text-center">
                    <h1 class="text-balance text-4xl font-semibold leading-tight sm:text-5xl">Ajoute un nouveau compte</h1>
                    <p class="mt-3 text-sm text-slate-300">Dans {{ clientLabel }}, crée un compte <strong>en plus</strong> de {{ sourceEmail }}. Ne remplace pas l’ancien. Type de compte : <strong>IMAP</strong> (pas Exchange, pas Microsoft 365, pas POP).</p>
                </div>
                <section class="ui-card mx-auto mt-8 max-w-2xl space-y-5">
                    <ol class="list-decimal space-y-3 pl-5 text-sm leading-relaxed text-slate-300">
                        {% if client == 'outlook-mac' %}
                            <li>Ouvre <strong>Outlook</strong> (l’application Microsoft, pas Mail d’Apple).</li>
                            <li>Dans la barre de menus en haut de l’écran : <strong>Outlook → Réglages</strong> (ou Préférences).</li>
                            <li>Clique sur <strong>Comptes</strong>, puis sur le bouton <strong>+</strong> en bas à gauche → <strong>Ajouter un compte</strong> (ou Nouveau compte).</li>
                            <li>Saisis <span class="font-mono text-slate-100">{{ targetEmail }}</span> puis <strong>Continuer</strong>.</li>
                            <li>Outlook va souvent proposer Microsoft 365 / Exchange. Refuse : cherche <strong>« Pas Microsoft ? »</strong>, <strong>« IMAP »</strong>, <strong>« Autre fournisseur »</strong> ou <strong>Options avancées → Configurer manuellement</strong>.</li>
                            <li>Choisis <strong>IMAP</strong>. Identifiant : l’adresse complète {{ targetEmail }}. Mot de passe : celui copié à l’étape précédente (pas le mot de passe de ton compte Microsoft).</li>
                            <li>Serveur de réception : <span class="font-mono text-slate-100">{{ mailClientSettings.imapHost }}</span>, port <span class="font-mono text-slate-100">{{ mailClientSettings.imapPort }}</span>, sécurité {{ mailClientSettings.imapEncryption }}.</li>
                            <li>Serveur d’envoi (SMTP) : <span class="font-mono text-slate-100">{{ mailClientSettings.smtpHost }}</span>, port <span class="font-mono text-slate-100">{{ mailClientSettings.smtpPort }}</span>, sécurité {{ mailClientSettings.smtpEncryption }}. Coche l’authentification SMTP, mêmes identifiant et mot de passe.</li>
                            <li>Valide. Dans la liste des comptes, tu dois voir {{ sourceEmail }} <strong>et</strong> {{ targetEmail }}. Si Outlook propose de migrer ou de remplacer l’ancien compte, annule.</li>
                        {% elseif client == 'thunderbird-mac' %}
                            <li>Ouvre <strong>Thunderbird</strong>.</li>
                            <li>Dans la barre de menus en haut de l’écran : <strong>Fichier → Nouveau → Compte de messagerie existant…</strong><br>Autre chemin : <strong>Thunderbird → Réglages</strong> (ou Outils → Paramètres des comptes) → en bas à gauche <strong>Actions pour le compte → Ajouter un compte de messagerie…</strong>.</li>
                            <li>Nom affiché : le tien. Adresse : <span class="font-mono text-slate-100">{{ targetEmail }}</span>. Mot de passe : celui copié à l’étape précédente. Coche « Mémoriser le mot de passe », puis <strong>Continuer</strong>.</li>
                            <li>Thunderbird va chercher tout seul et se trompera souvent sur @17b.fr. Clique tout de suite sur <strong>Configurer manuellement</strong> (ou Configuration manuelle).</li>
                            <li>Protocole entrant : <strong>IMAP</strong> (pas POP3).</li>
                            <li>Serveur entrant : <span class="font-mono text-slate-100">{{ mailClientSettings.imapHost }}</span> · port <span class="font-mono text-slate-100">{{ mailClientSettings.imapPort }}</span> · sécurité <strong>SSL/TLS</strong> · authentification <strong>Mot de passe normal</strong>. Nom d’utilisateur : l’adresse complète.</li>
                            <li>Serveur sortant (SMTP) : <span class="font-mono text-slate-100">{{ mailClientSettings.smtpHost }}</span> · port <span class="font-mono text-slate-100">{{ mailClientSettings.smtpPort }}</span> · sécurité <strong>SSL/TLS</strong> · authentification <strong>Mot de passe normal</strong>. Nom d’utilisateur : la même adresse.</li>
                            <li>Clique sur <strong>Retester</strong> (ou Réessayer). Quand c’est vert / valide, clique sur <strong>Terminé</strong>.</li>
                            <li>Dans le panneau de gauche, tu dois voir le dossier de {{ sourceEmail }} et celui de {{ targetEmail }}. Ne supprime pas l’ancien compte.</li>
                        {% elseif client == 'outlook' %}
                            <li>Ouvre Outlook. Selon la version : <strong>Fichier → Ajouter un compte</strong>, ou icône d’engrenage → <strong>Comptes → Ajouter un compte</strong>.</li>
                            <li>Saisis <span class="font-mono text-slate-100">{{ targetEmail }}</span>.</li>
                            <li>Choisis <strong>Configuration manuelle</strong> / <strong>Autoriser la configuration manuelle de mon compte</strong>.</li>
                            <li>Type : <strong>IMAP</strong> (pas Microsoft 365, pas Exchange, pas POP).</li>
                            <li>Identifiant : l’adresse complète. Mot de passe : celui de l’étape précédente.</li>
                            <li>Réception : {{ mailClientSettings.imapHost }} / {{ mailClientSettings.imapPort }} / SSL. Envoi : {{ mailClientSettings.smtpHost }} / {{ mailClientSettings.smtpPort }} / SSL, authentification SMTP activée.</li>
                            <li>Si Outlook propose de migrer ou remplacer un compte, refuse : tu dois avoir deux boîtes.</li>
                        {% elseif client == 'apple-mac' %}
                            <li>Ouvre <strong>Mail</strong> → barre de menus <strong>Mail → Réglages</strong> (ou Préférences) → onglet <strong>Comptes</strong>.</li>
                            <li>Clique sur <strong>+</strong> → <strong>Ajouter un compte</strong> → <strong>Autre compte Mail…</strong> (pas iCloud, pas Exchange, pas Google).</li>
                            <li>Nom : celui que tu veux afficher. Adresse e-mail : <span class="font-mono text-slate-100">{{ targetEmail }}</span>. Mot de passe : celui copié juste avant.</li>
                            <li>Si Mail demande les serveurs : IMAP {{ mailClientSettings.imapHost }} ({{ mailClientSettings.imapPort }}) et SMTP {{ mailClientSettings.smtpHost }} ({{ mailClientSettings.smtpPort }}), nom d’utilisateur = l’adresse complète.</li>
                            <li>Dans la barre latérale de Mail, laisse {{ sourceEmail }} coché. Tu dois voir les deux comptes.</li>
                        {% elseif client == 'iphone' %}
                            <li>Ouvre <strong>Réglages</strong> → <strong>Apps</strong> → <strong>Mail</strong> → <strong>Comptes</strong> (selon iOS : Réglages → Mail → Comptes).</li>
                            <li><strong>Ajouter un compte</strong> → <strong>Autre</strong> → <strong>Ajouter un compte Mail</strong>. Pas Google, pas Microsoft, pas Exchange.</li>
                            <li>Nom, adresse <span class="font-mono text-slate-100">{{ targetEmail }}</span>, mot de passe, description du type « 17b ».</li>
                            <li>Serveur de réception : {{ mailClientSettings.imapHost }}. Serveur d’envoi : {{ mailClientSettings.smtpHost }}. Identifiant : l’adresse complète, des deux côtés.</li>
                            <li>Ne supprime pas le compte {{ sourceEmail }} déjà présent.</li>
                        {% elseif client == 'thunderbird' %}
                            <li>Thunderbird → menu ☰ → <strong>Paramètres des comptes</strong>.</li>
                            <li>En bas à gauche : <strong>Actions pour le compte → Ajouter un compte de messagerie…</strong>.</li>
                            <li>Adresse : <span class="font-mono text-slate-100">{{ targetEmail }}</span>, mot de passe de l’étape précédente, puis <strong>Configurer manuellement</strong>.</li>
                            <li>IMAP · {{ mailClientSettings.imapHost }} · {{ mailClientSettings.imapPort }} · SSL/TLS. SMTP · {{ mailClientSettings.smtpHost }} · {{ mailClientSettings.smtpPort }} · SSL/TLS. Identifiant = l’adresse complète.</li>
                            <li>Retester, puis Terminé, sans retirer {{ sourceEmail }}.</li>
                        {% elseif client == 'gmail' %}
                            <li>Sur téléphone : Gmail → ta photo → <strong>Ajouter un autre compte</strong> → <strong>Autre</strong>.</li>
                            <li>Choisis IMAP. Adresse : <span class="font-mono text-slate-100">{{ targetEmail }}</span>. Identifiant = l’adresse complète.</li>
                            <li>Colle le mot de passe, puis les serveurs : IMAP {{ mailClientSettings.imapHost }} ({{ mailClientSettings.imapPort }}), SMTP {{ mailClientSettings.smtpHost }} ({{ mailClientSettings.smtpPort }}).</li>
                            <li>Sur ordinateur, Outlook, Mail ou Thunderbird est plus simple que Gmail web.</li>
                        {% else %}
                            <li>Ouvre les paramètres du logiciel → Ajouter un compte (pas « remplacer », pas « migrer »).</li>
                            <li>Type : <strong>IMAP</strong> uniquement.</li>
                            <li>Nom d’utilisateur : l’adresse complète <span class="font-mono text-slate-100">{{ targetEmail }}</span>.</li>
                            <li>Mot de passe : celui de l’étape identifiants.</li>
                            <li>Les serveurs IMAP/SMTP sont rappelés à l’étape suivante.</li>
                        {% endif %}
                    </ol>
                </section>
                <div class="mx-auto mt-8 flex max-w-2xl justify-end">
                    <a class="ui-button-primary px-6 py-3 text-base" href="{{ path('app_user_mailbox_setup', wizardParams|merge({ step: nextStep })) }}">Continuer</a>
                </div>

            {% elseif step == 'parametres' %}
                <div class="mx-auto max-w-lg text-center">
                    <h1 class="text-balance text-4xl font-semibold leading-tight sm:text-5xl">Paramètres serveur</h1>
                    <p class="mt-3 text-sm text-slate-300">Recopie ces valeurs si le logiciel les demande encore. Nom d’utilisateur : l’adresse complète, pas seulement la partie avant le @.</p>
                </div>
                <section class="ui-card mx-auto mt-8 max-w-lg space-y-4">
                    <div>
                        <p class="text-xs uppercase tracking-wide text-slate-400">Nom d’utilisateur</p>
                        <p class="mt-1 font-mono text-sm text-slate-100">{{ targetEmail }}</p>
                    </div>
                    <div class="rounded-lg border border-slate-800 bg-slate-950/40 p-4">
                        <p class="text-xs uppercase tracking-wide text-slate-400">Réception IMAP</p>
                        <dl class="mt-2 space-y-2 text-sm">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <dt class="text-slate-400">Serveur</dt>
                                <dd class="flex items-center gap-2">
                                    <span class="font-mono text-slate-100">{{ mailClientSettings.imapHost }}</span>
                                    <button type="button" class="ui-button-secondary px-2 py-1 text-xs" data-copy-text="{{ mailClientSettings.imapHost }}">Copier</button>
                                </dd>
                            </div>
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <dt class="text-slate-400">Port</dt>
                                <dd class="font-mono text-slate-100">{{ mailClientSettings.imapPort }}</dd>
                            </div>
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <dt class="text-slate-400">Sécurité</dt>
                                <dd class="text-slate-100">{{ mailClientSettings.imapEncryption }}</dd>
                            </div>
                        </dl>
                    </div>
                    <div class="rounded-lg border border-slate-800 bg-slate-950/40 p-4">
                        <p class="text-xs uppercase tracking-wide text-slate-400">Envoi SMTP</p>
                        <dl class="mt-2 space-y-2 text-sm">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <dt class="text-slate-400">Serveur</dt>
                                <dd class="flex items-center gap-2">
                                    <span class="font-mono text-slate-100">{{ mailClientSettings.smtpHost }}</span>
                                    <button type="button" class="ui-button-secondary px-2 py-1 text-xs" data-copy-text="{{ mailClientSettings.smtpHost }}">Copier</button>
                                </dd>
                            </div>
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <dt class="text-slate-400">Port</dt>
                                <dd class="font-mono text-slate-100">{{ mailClientSettings.smtpPort }}</dd>
                            </div>
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <dt class="text-slate-400">Sécurité</dt>
                                <dd class="text-slate-100">{{ mailClientSettings.smtpEncryption }}</dd>
                            </div>
                        </dl>
                    </div>
                    <p class="text-sm text-slate-400">Authentification SMTP activée, avec la même adresse et le même mot de passe que pour IMAP.</p>
                </section>
                <div class="mx-auto mt-8 flex max-w-lg justify-end">
                    <a class="ui-button-primary px-6 py-3 text-base" href="{{ path('app_user_mailbox_setup', wizardParams|merge({ step: nextStep })) }}">Continuer</a>
                </div>

            {% else %}
                <div class="mx-auto max-w-lg text-center">
                    <h1 class="text-balance text-4xl font-semibold leading-tight sm:text-5xl">C’est bon</h1>
                    <p class="mt-4 text-base text-slate-300">Tu dois maintenant voir <strong>{{ targetEmail }}</strong> et <strong>{{ sourceEmail }}</strong> dans {{ clientLabel|default('ton logiciel') }}.</p>
                    <p class="mt-2 text-sm text-slate-400">Les e-mails déjà reçus sur @b17.fr restent dans l’ancien compte. Les nouveaux arrivent aussi sur @17b.fr.</p>
                </div>
                <div class="mx-auto mt-8 flex max-w-lg flex-col gap-3">
                    <a class="ui-button-primary px-6 py-3 text-center text-base" href="{{ path('app_user_account', { accountId: currentAccountId }) }}">Gérer le répondeur et les redirections</a>
                    <a class="ui-button-secondary px-6 py-3 text-center text-base" href="{{ path('app_user_mailbox_setup', accountParams|merge({ step: 'client' })) }}">Recommencer avec un autre logiciel</a>
                </div>
            {% endif %}
        {% endif %}
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('[data-toggle-password]').forEach((button) => {
                button.addEventListener('click', () => {
                    const input = document.getElementById(button.getAttribute('data-toggle-password'));
                    if (!input) {
                        return;
                    }
                    const hidden = input.type === 'password';
                    input.type = hidden ? 'text' : 'password';
                    button.textContent = hidden ? 'Masquer' : 'Afficher';
                });
            });

            document.querySelectorAll('[data-copy]').forEach((button) => {
                button.addEventListener('click', async () => {
                    const input = document.querySelector(button.getAttribute('data-copy'));
                    if (!input) {
                        return;
                    }
                    try {
                        await navigator.clipboard.writeText(input.value);
                        button.textContent = 'Copié';
                        setTimeout(() => {
                            button.textContent = 'Copier';
                        }, 1500);
                    } catch {
                        input.select();
                        document.execCommand('copy');
                    }
                });
            });

            document.querySelectorAll('[data-copy-text]').forEach((button) => {
                button.addEventListener('click', async () => {
                    const value = button.getAttribute('data-copy-text') || '';
                    try {
                        await navigator.clipboard.writeText(value);
                        button.textContent = 'Copié';
                        setTimeout(() => {
                            button.textContent = 'Copier';
                        }, 1500);
                    } catch {
                        // ignore
                    }
                });
            });
        });
